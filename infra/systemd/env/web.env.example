WEB_HOST=0.0.0.0
WEB_PORT=5173

# Public host used by Vite HMR when the server is accessed through a domain.
# The site is served over HTTPS behind nginx, so HMR must use wss on 443 — a ws/80
# client is blocked as mixed content and HMR silently dies (stale bundle in the browser).
VITE_PUBLIC_HOST=approid.team
VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=443
