SPRING_PROFILES_ACTIVE=database
API_PORT=8081

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=my_forever_music
DB_USERNAME=postgres
DB_PASSWORD=postgres

AI_SERVICE_BASE_URL=http://127.0.0.1:8000

# Provider credentials. Fill these on the server only.
# For approid.team traffic, also register these callback URLs in provider dashboards
# and set SPOTIFY_REDIRECT_URI/TIDAL_REDIRECT_URI to:
# https://approid.team/platforms/oauth/callback
SPOTIFY_OAUTH_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://imapplepie20.tplinkdns.com/platforms/oauth/callback
SPOTIFY_AUTHORIZATION_URI=https://accounts.spotify.com/authorize
SPOTIFY_TOKEN_URI=https://accounts.spotify.com/api/token
SPOTIFY_API_BASE_URI=https://api.spotify.com/v1
SPOTIFY_SCOPES=user-read-email,playlist-read-private,playlist-read-collaborative,streaming,user-read-playback-state,user-modify-playback-state,user-read-currently-playing
TIDAL_OAUTH_ENABLED=true
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_REDIRECT_URI=https://imapplepie20.tplinkdns.com/platforms/oauth/callback
TIDAL_AUTHORIZATION_URI=https://login.tidal.com/authorize
TIDAL_TOKEN_URI=https://auth.tidal.com/v1/oauth2/token
TIDAL_API_BASE_URI=https://openapi.tidal.com/v2
TIDAL_LEGACY_API_BASE_URI=https://api.tidal.com/v1
TIDAL_COUNTRY_CODE=KR
# Only device-authorization scopes (r_usr,w_usr,w_sub) take effect; any other value is ignored.
TIDAL_SCOPES=r_usr,w_usr,w_sub
LASTFM_ENABLED=false
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_API_ROOT=https://ws.audioscrobbler.com/2.0/
YOUTUBE_DATA_API_KEY=
DISCOGS_TOKEN=

# Audio feature completion and taste serving gates.
RECCOBEATS_ENABLED=true
RECCOBEATS_API_BASE_URL=https://api.reccobeats.com/v1
AUDIO_FEATURES_COMPLETION_SCHEDULER_ENABLED=false
AUDIO_FEATURES_COMPLETION_SCHEDULER_FIXED_DELAY_MS=300000
AUDIO_FEATURES_COMPLETION_SCHEDULER_INITIAL_DELAY_MS=60000
AUDIO_FEATURES_COMPLETION_SCHEDULER_BATCH_LIMIT=20
AUDIO_FEATURES_COMPLETION_SCHEDULER_WORKER_ID=audio-feature-completion-scheduler
AUDIO_FEATURES_COMPLETION_LASTFM_MIN_CONFIDENCE=0.55
AUDIO_TASTE_MIN_POSITIVE_READY_TRACKS=10
AUDIO_TASTE_MIN_FEATURE_READY_RATIO=0.30
APP_RECOMMENDATION_TASTE_MODE_AFFINITY_GATE_ENABLED=true
APP_RECOMMENDATION_TASTE_MODE_AFFINITY_DRY_RUN_ENABLED=true
APP_RECOMMENDATION_TASTE_MODE_AFFINITY_APPLY_RANKING_BOOST=false
APP_RECOMMENDATION_TASTE_MODE_AFFINITY_MIN_PROFILE_CONFIDENCE=0.55
APP_RECOMMENDATION_TASTE_MODE_AFFINITY_MIN_SIMILARITY=0.82
APP_RECOMMENDATION_TASTE_MODE_AFFINITY_MAX_DISTANCE=0.18
APP_RECOMMENDATION_TASTE_MODE_AFFINITY_MAX_BOOST_WEIGHT=0.03

# Verified 2026-05-22 Ubuntu rollout profile for the current sparse heavy user.
# Enable intentionally, monitor audit rank_changed_count, and roll back by setting
# APP_RECOMMENDATION_TASTE_MODE_AFFINITY_APPLY_RANKING_BOOST=false.
# AUDIO_TASTE_MIN_FEATURE_READY_RATIO=0.07
# APP_RECOMMENDATION_TASTE_MODE_AFFINITY_APPLY_RANKING_BOOST=true
# APP_RECOMMENDATION_TASTE_MODE_AFFINITY_MIN_PROFILE_CONFIDENCE=0.10
# APP_RECOMMENDATION_TASTE_MODE_AFFINITY_MAX_BOOST_WEIGHT=0.30

# Scheduled collectors. Leave user id empty to make the scheduler skip safely.
EMS_DISCOVERY_ENABLED=true
EMS_DISCOVERY_USER_ID=
EMS_ACQUISITION_ENABLED=true
EMS_ACQUISITION_USER_ID=
EMS_FLO_SPECIAL_ENABLED=true
MELON_SCRAPE_ENABLED=false
